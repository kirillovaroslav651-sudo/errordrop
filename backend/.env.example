# === Токен бота от @BotFather ===
BOT_TOKEN=123456789:AAA...

# === Публичный HTTPS-адрес сервера (для invoice и вебхука) ===
# Локально: используйте мой-туннель (ngrok / cloudflared / localtunnel) и вставьте https-ссылку сюда
BASE_URL=https://your-server.example.com

# === Режим приёма апдейтов от Telegram ===
# webhook  — продакшн (требует HTTPS-домен)
# polling  — локальная отладка без вебхука
BOT_MODE=webhook

# === Порт сервера ===
PORT=3000

# === Telegram ID администраторов (через запятую). Здесь magic-кнопка накрутки ===
ADMIN_IDS=123456789

# === Допустимая давность initData (играет роль anti-replay), в секундах ===
INITDATA_MAX_AGE=86400

# === Ежедневный бонус (звёзд в сутки) ===
DAILY_BONUS=5

# === Публичный адрес frontend (Mini App), куда ведут кнопки ===
WEBAPP_URL=https://your-webapp.example.com
# Postgres / Supabase Session pooler (IPv4)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Случайный секрет для проверки Telegram webhook
WEBHOOK_SECRET=replace-with-random-32-char-string

